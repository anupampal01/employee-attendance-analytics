# Copy to .env (never commit .env). Real environment variables always take priority over this file.
# Local MongoDB:
MONGO_URI=mongodb://localhost:27017
# MongoDB Atlas example (placeholders only):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_DB=attendance_db
# Comma-separated list of browser origins allowed to call the API (the Vite dev server by default):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
